NODE_ENV=development
# Étiquette d'environnement : vide en production ; "PREPROD" ou "DEVELOPPEMENT" ailleurs.
# Une étiquette non vide redirige toutes les notifications Tchap vers le salon de test, même si NODE_ENV=production.
# En préproduction, ne pas y renseigner les identifiants des vrais salons.
RB_API_ENV_LABEL=
RB_API_PORT=8090
RB_API_CPU_INSTANCES=1
RB_API_BACK_URL=https://api.resorption-bidonvilles.localhost
RB_API_FRONT_DOMAIN=resorption-bidonvilles.localhost
RB_API_BLOG_URL=https://www.blog-resorption-bidonvilles.fr/

# Authentification
RB_API_AUTH_SECRET=MettreUnSecretIci
RB_API_AUTH_EXPIRES_IN=10m
RB_API_ACTIVATION_TOKEN_EXPIRES_IN=168h
RB_API_PASSWORD_RESET_EXPIRES_IN=24h

# Mailing
RB_API_TEST_EMAIL=ton-email@ton-domaine.fr
RB_API_MAILJET_PUBLIC_KEY=
RB_API_MAILJET_PRIVATE_KEY=

# Identifiants MongoDB
RB_API_MONGO_HOST=localhost
RB_API_MONGO_USERNAME=rbadmin
RB_API_MONGO_PASSWORD=rbadmin

# Identifiants S3
RB_API_S3_ENDPOINT=
RB_API_S3_PUBLIC_ENDPOINT=
RB_API_S3_ACCESS_KEY=
RB_API_S3_SECRET_KEY=
RB_API_S3_REGION=
RB_API_S3_BUCKET=

# Identifiants PgSQL
RB_API_POSTGRES_HOST=localhost
RB_API_POSTGRES_PORT=3232
RB_API_POSTGRES_DB=resorption_bidonvilles
RB_API_POSTGRES_USER=
RB_API_POSTGRES_PASSWORD=

# Infos accès base MAJIC PgSQL
RB_API_MAJIC_POSTGRES_HOST=localhost
RB_API_MAJIC_POSTGRES_PORT=3233
RB_API_MAJIC_POSTGRES_DB=majic
RB_API_MAJIC_POSTGRES_PASSWORD=

# Autres services
# ==============================================================================
# CONFIGURATION TCHAP / MATRIX
# ==============================================================================

# URL du serveur d'accueil (Homeserver) Tchap émetteur
# https:// obligatoire en production (barre oblique finale tolérée) ; hors production, http://localhost, http://127.0.0.1 et http://[::1] sont tolérés.
# Toute autre valeur est refusée : aucune notification n'est envoyée et l'erreur est signalée à Sentry.
RB_API_TCHAP_BASE_URL=https://
# Jeton d'accès (Access Token) Tchap (récupéré via `config.tchap`)
RB_API_TCHAP_TOKEN=
# Salons Tchap : chaque variable est lue dans server/config.ts (tchap.channels).
# Room ID Matrix commençant par ! (ex. !xxxx:serveur), obligatoire en production ; toute autre valeur (alias #…, URL collée) est refusée et signalée à Sentry.
# Une variable absente = notification non envoyée et signalée à Sentry.
# En développement, seule RB_API_TCHAP_NOTIF_DEV_TEST est utilisée (toutes les notifications y sont redirigées).
RB_API_TCHAP_NOTIF_DEV_TEST=
RB_API_TCHAP_NOTIF_INVITATIONS_INTERVENANTS=
RB_API_TCHAP_NOTIF_NETTOYAGE_PIECES_JOINTES=
RB_API_TCHAP_NOTIF_INTERVENANTS_DECLARES=
RB_API_TCHAP_NOTIF_CANICULE=
RB_API_TCHAP_NOTIF_REQUETES_CADASTRE=
RB_API_TCHAP_NOTIF_ACTION_NOUVEAU_COMMENTAIRE=
RB_API_TCHAP_NOTIF_SITE_NOUVEAU_COMMENTAIRE=
RB_API_TCHAP_NOTIF_NOUVEAUX_UTILISATEURS=
RB_API_TCHAP_TECH=
RB_API_TCHAP_NOTIF_AUTO_DESACTIVATIONS=
RB_API_TCHAP_NOTIF_ANONYMISATION=
RB_API_TCHAP_NOTIF_PERSONNES_INVITEES=
RB_API_TCHAP_NOTIF_ABSENCE_PILOTE_ACTION=
RB_API_TCHAP_NOTIF_FERMETURE_SITES=
RB_API_TCHAP_NOTIF_REINSTALLATION=
RB_API_TCHAP_NOTIF_OUVERTURE_SITES=

RB_API_SENTRY_DSN=
RB_API_SOLIGUIDE_KEY=

# Fonctionnalités à (dés)activer
RB_API_SEND_ACTIVITY_SUMMARY=0
RB_API_SEND_ACTION_ALERTS=0
RB_API_CHECK_INACTIVE_USERS=0
RB_API_CLEAN_ATTACHMENTS_ARCHIVES=0
RB_API_ANONYMIZE_OWNERS=0
RB_API_ANONYMIZE_INACTIVE_USERS=0
RB_API_DEACTIVATE_EXPIRED_USERS=0

# ClamAV
RB_API_CLAMAV_PORT=9000
RB_API_CLAMAV_URL=localhost

# Keycloak
RB_API_KEYCLOAK_ENABLED=1
RB_API_KEYCLOAK_URL=http://localhost:8080
RB_API_KEYCLOAK_CLIENT_ID=rb-front
RB_API_KEYCLOAK_BACK_CLIENT_ADMIN=rb-admin
RB_API_KEYCLOAK_BACK_CLIENT_ADMIN_SECRET=
KEYCLOAK_POSTGRES_DB=keycloak_db
KEYCLOAK_POSTGRES_USER=keycloak_db_user
KEYCLOAK_POSTGRES_PASSWORD=keycloak_db_user_password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=p@55w0rd!
KEYCLOAK_HOSTNAME=keycloak.resorption-bidonvilles.localhost
KEYCLOAK_REALM=SISIAO